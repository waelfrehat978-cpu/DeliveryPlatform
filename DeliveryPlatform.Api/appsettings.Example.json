{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=DeliveryPlatformDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Order": {
    "DeliveryFee": 2.50
  },
  "Jwt": {
    "Key": "REPLACE-WITH-A-SECRET-KEY-OF-AT-LEAST-32-CHARACTERS",
    "Issuer": "DeliveryPlatform",
    "Audience": "DeliveryPlatform",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "MaxWrongTries": 5,
    "SecondsBetweenRequests": 60,
    "MaxRequestsPerHour": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}