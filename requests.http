# DeliveryPlatform - API Requests

@baseUrl = https://localhost:7195

##################################################
# DAY 1 - LOGIN FLOWS
##################################################

# Test variables
@adminEmail = admin@example.com
@adminPassword = PASTE_ADMIN_PASSWORD
@partnerEmail = partner1@example.com
@partnerPassword = PASTE_PARTNER_PASSWORD
@customerPhone = PASTE_CUSTOMER_PHONE
@customerOtp = PASTE_CUSTOMER_OTP
@customerSignupToken = PASTE_CUSTOMER_SIGNUP_TOKEN
@refreshToken = PASTE_REFRESH_TOKEN
@accessToken = PASTE_ACCESS_TOKEN


##################################################
# 1 - ADMIN LOGIN
##################################################

### [1.1] Admin Staff Login
POST {{baseUrl}}/api/v1/auth/staff-login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}


##################################################
# 2 - PARTNER LOGIN
##################################################

### [2.1] Partner Staff Login
POST {{baseUrl}}/api/v1/auth/staff-login
Content-Type: application/json

{
  "email": "{{partnerEmail}}",
  "password": "{{partnerPassword}}"
}


##################################################
# 3 - CUSTOMER OTP LOGIN
##################################################

### [3.1] Request OTP
POST {{baseUrl}}/api/v1/auth/request-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerPhone}}"
}

### [3.2] Verify OTP
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerPhone}}",
  "code": "{{customerOtp}}"
}


##################################################
# 4 - REFRESH TOKENS
##################################################

### [4.1] Refresh Access Token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}


##################################################
# 5 - GET CURRENT USER
##################################################

### [5.1] Get Current User
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{accessToken}}


##################################################
# 6 - LOGOUT
##################################################

### [6.1] Logout
POST {{baseUrl}}/api/v1/auth/logout
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}


##################################################
# DAY 2 - PART 6 - ATTACK TESTS
##################################################

# Test variables
@customerAToken = PASTE_CUSTOMER_A_TOKEN
@partnerToken = PASTE_PARTNER_TOKEN
@customerBOrderId = 1199991
@otherStoreProductId = PASTE_OTHER_STORE_PRODUCT_ID
@customerAPhone = PASTE_CUSTOMER_A_PHONE
@customerBPhone = PASTE_CUSTOMER_B_PHONE
@fakePhone = 0799999999
@rateLimitPhone = PASTE_TEST_PHONE
@wrongOtpCode = 111111
@otpCode = PASTE_OTP_FROM_LOGS
@refreshTokenToReuse = PASTE_FRESH_REFRESH_TOKEN
@tamperedToken = PASTE_TAMPERED_TOKEN
@expiredAccessToken = PASTE_EXPIRED_ACCESS_TOKEN

##################################################
# ATTACK 1 - NO TOKEN
##################################################

### [1] No Token
GET {{baseUrl}}/api/v1/orders/900001

##################################################
# ATTACK 2 - GARBAGE TOKEN
##################################################

### [2] Garbage Token
GET {{baseUrl}}/api/v1/orders/900001
Authorization: Bearer abc.def.ghi

##################################################
# ATTACK 3 - CUSTOMER A ACCESS CUSTOMER B ORDER
##################################################

### [3.1] Customer A accesses Customer B order
GET {{baseUrl}}/api/v1/orders/{{customerBOrderId}}
Authorization: Bearer {{customerAToken}}

##################################################
# ATTACK 4 - PARTNER ACCESS ANOTHER STORE PRODUCT
##################################################

### [4.1] Partner updates another store product
PUT {{baseUrl}}/api/v1/products/{{otherStoreProductId}}
Authorization: Bearer {{partnerToken}}
Content-Type: application/json

{
  "name": "Unauthorized Update Test",
  "description": "Authorization test",
  "price": 10,
  "stockQuantity": 10,
  "categoryId": 1
}

##################################################
# ATTACK 5 - TAMPERED JWT
##################################################

### [5.1] Tampered JWT
GET {{baseUrl}}/api/v1/orders/900001
Authorization: Bearer {{tamperedToken}}

##################################################
# ATTACK 6 - ALG NONE
##################################################

### [6.1] Unsigned token
GET {{baseUrl}}/api/v1/orders/900001
Authorization: Bearer PASTE_UNSIGNED_TEST_TOKEN

##################################################
# ATTACK 7 - EXPIRED ACCESS TOKEN
##################################################

### [7.1] Expired Access Token
GET {{baseUrl}}/api/v1/products
Authorization: Bearer {{expiredAccessToken}}

### [7.2] Refresh after expiration
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshTokenToReuse}}"
}

##################################################
# ATTACK 8 - REUSE OLD REFRESH TOKEN
##################################################

### [8.1] First refresh
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshTokenToReuse}}"
}

### [8.2] Reuse old refresh token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshTokenToReuse}}"
}

##################################################
# ATTACK 9 - OTP WRONG ATTEMPTS
##################################################

### [9.1] Wrong OTP attempt 1
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerAPhone}}",
  "code": "{{wrongOtpCode}}"
}

### [9.2] Wrong OTP attempt 2
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerAPhone}}",
  "code": "{{wrongOtpCode}}"
}

### [9.3] Wrong OTP attempt 3
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerAPhone}}",
  "code": "{{wrongOtpCode}}"
}

### [9.4] Wrong OTP attempt 4
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerAPhone}}",
  "code": "{{wrongOtpCode}}"
}

### [9.5] Wrong OTP attempt 5
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerAPhone}}",
  "code": "{{wrongOtpCode}}"
}

### [9.6] Correct OTP after failed attempts
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerAPhone}}",
  "code": "{{otpCode}}"
}

##################################################
# ATTACK 10 - USE OTP TWICE
##################################################

### [10.1] First OTP verification
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerBPhone}}",
  "code": "{{otpCode}}"
}

### [10.2] Second OTP verification
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerBPhone}}",
  "code": "{{otpCode}}"
}

##################################################
# ATTACK 11 - OTP RATE LIMIT
##################################################

### [11.1] OTP request 1
POST {{baseUrl}}/api/v1/auth/request-otp
Content-Type: application/json

{
  "phoneNumber": "{{rateLimitPhone}}"
}

### [11.2] OTP request 2
POST {{baseUrl}}/api/v1/auth/request-otp
Content-Type: application/json

{
  "phoneNumber": "{{rateLimitPhone}}"
}

### [11.3] OTP request 3
POST {{baseUrl}}/api/v1/auth/request-otp
Content-Type: application/json

{
  "phoneNumber": "{{rateLimitPhone}}"
}

##################################################
# ATTACK 12 - ACCOUNT ENUMERATION
##################################################

### [12.1] Existing Customer
POST {{baseUrl}}/api/v1/auth/request-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerAPhone}}"
}

### [12.2] Fake Customer
POST {{baseUrl}}/api/v1/auth/request-otp
Content-Type: application/json

{
  "phoneNumber": "{{fakePhone}}"
}

### [12.3] Existing Staff with wrong password
POST {{baseUrl}}/api/v1/auth/staff-login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "DefinitelyWrongPassword123!"
}

### [12.4] Fake Staff
POST {{baseUrl}}/api/v1/auth/staff-login
Content-Type: application/json

{
  "email": "not-existing-user@example.com",
  "password": "DefinitelyWrongPassword123!"
}
