  "email": "not-existing-user@example.com",
  "password": "DefinitelyWrongPassword123!"
}

##################################################
# DAY 2.5 - PART 6 - AUDIT HISTORY
##################################################

### [1.1] Update Product Price
PUT {{baseUrl}}/api/v1/products/{{auditProductId}}
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Intelligent Soft Salad 1",
  "description": "REPLACE_WITH_CURRENT_DESCRIPTION",
  "price": 12.55,
  "stockQuantity": 298,
  "categoryId": 135
}

### [2.1] Admin Reads Product History
GET {{baseUrl}}/api/v1/products/{{auditProductId}}/history?page=1&pageSize=10
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### [2.2] Partner Reads Own Product History
GET {{baseUrl}}/api/v1/products/{{auditProductId}}/history?page=1&pageSize=10
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}

### [2.3] Customer Attempts Product History (Expected: 403)
GET {{baseUrl}}/api/v1/products/{{auditProductId}}/history?page=1&pageSize=10
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### [2.4] Partner Attempts Another Store Product History (Expected: 403)
GET {{baseUrl}}/api/v1/products/{{otherStoreProductId}}/history?page=1&pageSize=10
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}

### [3.1] Admin Reads Order History
GET {{baseUrl}}/api/v1/orders/{{auditOrderId}}/history?page=1&pageSize=10
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### [3.2] Partner Attempts Order History (Expected: 403)
GET {{baseUrl}}/api/v1/orders/{{auditOrderId}}/history?page=1&pageSize=10
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}

### [3.3] Customer Attempts Order History (Expected: 403)
GET {{baseUrl}}/api/v1/orders/{{auditOrderId}}/history?page=1&pageSize=10
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### [4.1] Admin Reads Customer History
GET {{baseUrl}}/api/v1/customers/{{auditCustomerId}}/history?page=1&pageSize=10
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### [4.2] Partner Attempts Customer History (Expected: 403)
GET {{baseUrl}}/api/v1/customers/{{auditCustomerId}}/history?page=1&pageSize=10
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}

### [5.1] Admin Reads Store History
GET {{baseUrl}}/api/v1/stores/{{auditStoreId}}/history?page=1&pageSize=10
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

### [5.2] Partner Attempts Store History (Expected: 403)
GET {{baseUrl}}/api/v1/stores/{{auditStoreId}}/history?page=1&pageSize=10
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}

##################################################
# DAY 1 - STORE DASHBOARD (MUST BE LAST)
##################################################

### [5.1] Partner Reads Store Dashboard
GET {{baseUrl}}/api/v1/stores/{{day1StoreId}}/dashboard
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}
