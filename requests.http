
# DeliveryPlatform - API Requests

@baseUrl = https://localhost:7195

##################################################
# TEST DATA
##################################################

@adminEmail = admin@example.com
@adminPassword = PASTE_ADMIN_PASSWORD

@partnerEmail = partner1@example.com
@partnerPassword = PASTE_PARTNER_PASSWORD

@customerPhone = PASTE_CUSTOMER_PHONE
@customerOtp = PASTE_CUSTOMER_OTP

@customerAPhone = PASTE_CUSTOMER_A_PHONE
@customerBPhone = PASTE_CUSTOMER_B_PHONE

@fakePhone = 0799999999
@rateLimitPhone = PASTE_TEST_PHONE
@wrongOtpCode = 111111
@otpCode = PASTE_OTP_FROM_LOGS

@customerBOrderId = 1199991
@otherStoreProductId = PASTE_OTHER_STORE_PRODUCT_ID

@auditProductId = 120002
@auditOrderId = 1500002
@auditCustomerId = 120004
@auditStoreId = 254

@day1AddressId = 175001
@day1StoreId = 255
@day1ProductId = 160003

##################################################
# DAY 1 - LOGIN FLOWS
##################################################

### [1.1] Admin Staff Login
# @name adminLogin
POST {{baseUrl}}/api/v1/auth/staff-login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### [2.1] Partner Staff Login
# @name partnerLogin
POST {{baseUrl}}/api/v1/auth/staff-login
Content-Type: application/json

{
  "email": "{{partnerEmail}}",
  "password": "{{partnerPassword}}"
}

### [3.1] Request Customer OTP
# @name customerOtpRequest
POST {{baseUrl}}/api/v1/auth/request-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerPhone}}"
}

### [3.2] Verify Customer OTP
# @name customerLogin
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

{
  "phoneNumber": "{{customerPhone}}",
  "code": "{{customerOtp}}"
}

##################################################
# DAY 1 - CUSTOMER STORY
##################################################

### [4.1] Add Customer Address
# @name createAddress
POST {{baseUrl}}/api/v1/addresses
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "customerId": 120004,
  "label": "Home",
  "street": "Test Street",
  "city": "Amman",
  "latitude": 31.9539,
  "longitude": 35.9106,
  "isDefault": true
}

### [4.2] Search Products
# @name searchProducts
GET {{baseUrl}}/api/v1/products
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### [4.3] Create Order
# @name createOrder
POST {{baseUrl}}/api/v1/orders
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "storeId": {{day1StoreId}},
  "addressId": {{day1AddressId}},
  "items": [
    {
      "productId": {{day1ProductId}},
      "quantity": 1
    }
  ],
  "paymentMethod": 0
}

### [4.4] Read Created Order
# @name readCreatedOrder
GET {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### [4.5] Update Order Status
# @name updateOrderStatus
PUT {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}/status
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "status": 1,
  "note": "Order accepted"
}

### [4.6] Read Order History
# @name readOrderHistory
GET {{baseUrl}}/api/v1/orders/{{createOrder.response.body.$.id}}/history?page=1&pageSize=10
Authorization: Bearer {{adminLogin.response.body.$.accessToken}}

##################################################
# DAY 2 - PART 6 - ATTACK TESTS
##################################################

### [1] No Token
GET {{baseUrl}}/api/v1/orders/900001

### [2] Garbage Token
GET {{baseUrl}}/api/v1/orders/900001
Authorization: Bearer abc.def.ghi

### [3.1] Customer A Accesses Customer B Order
GET {{baseUrl}}/api/v1/orders/{{customerBOrderId}}
Authorization: Bearer {{customerLogin.response.body.$.accessToken}}

### [4.1] Partner Updates Another Store Product
PUT {{baseUrl}}/api/v1/products/{{otherStoreProductId}}
Authorization: Bearer {{partnerLogin.response.body.$.accessToken}}
Content-Type: application/json

{
  "name": "Unauthorized Update Test",
  "description": "Authorization test",
  "price": 10,
  "stockQuantity": 10,
  "categoryId": 1
}

### [5.1] Tampered JWT
GET {{baseUrl}}/api/v1/orders/900001
Authorization: Bearer abc.def.ghi

### [6.1] Unsigned Token
GET {{baseUrl}}/api/v1/orders/900001
Authorization: Bearer eyJhbGciOiJub25lIn0.eyJzdWIiOiIxIn0.

### [7.1] Expired Access Token
GET {{baseUrl}}/api/v1/products
Authorization: Bearer PASTE_EXPIRED_ACCESS_TOKEN

### [7.2] Refresh After Expiration
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{customerLogin.response.body.$.refreshToken}}"
}

### [8.1] First Refresh
# @name firstRefresh
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{partnerLogin.response.body.$.refreshToken}}"
}

### [8.2] Reuse Old Refresh Token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{partnerLogin.response.body.$.refreshToken}}"
}

### [9.1] Wrong OTP Attempt 1
POST {{baseUrl}}/api/v1/auth/verify-otp
Content-Type: application/json

